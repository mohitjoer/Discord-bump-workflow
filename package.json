{
  "name": "discord-bump-workflow",
  "version": "1.0.0",
  "description": "Automated TypeScript Playwright workflow to periodically bump Discord servers on Disboard",
  "type": "module",
  "scripts": {
    "login": "tsx src/login.ts",
    "export-secret": "tsx src/export-secret.ts",
    "bump": "tsx src/bump-disboard.ts",
    "bump:disboard": "tsx src/bump-disboard.ts",
    "start": "tsx src/index.ts",
    "build": "tsc"
  },
  "keywords": [
    "discord",
    "bump",
    "disboard",
    "playwright",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.63.0",
    "rebrowser-playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
