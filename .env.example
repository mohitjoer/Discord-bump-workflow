# ==============================================================================
# DISCORD BUMP WORKFLOW CONFIGURATION (.env.example - DISBOARD ONLY)
# ==============================================================================

# 1. Disboard Configuration
DISBOARD_SERVER_ID=
DISBOARD_DASHBOARD_URL=https://disboard.org/dashboard/servers
DISBOARD_BUMP_INTERVAL_MINUTES=250

# 2. Notifications (Optional)
DISCORD_WEBHOOK_URL=

# 3. Runner & Browser Settings
HEADLESS=true
USER_DATA_DIR=./user-data
RUN_INTERVAL_MINUTES=30
